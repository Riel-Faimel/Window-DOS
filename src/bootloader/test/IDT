class IDT {
public:
    #pragma pack(push, 1)
    struct IDT_item{
        unsigned short addr_low = 0;
        unsigned short selector = 0x08;
        unsigned char zero = 0;
        unsigned char type_attr = 0x8E;
        unsigned short addr_high = 0;
    };
    #pragma pack(pop)

    IDT_item *idt_base;

    IDT(IDT_item *tab):idt_base(tab){
        for(volatile unsigned short i = 0;i < 256;i++){
            idt_base[i] = {};
        }

        idt_base[0] = IDT_item{
            .addr_low = (unsigned short)(reinterpret_cast<unsigned>(&DE_handler) & 0xFFFF),
            .addr_high = (unsigned short)((reinterpret_cast<unsigned>(&DE_handler) >> 16) & 0xFFFF)
        }; //除零异常
        idt_base[4] = IDT_item{
            .addr_low = (unsigned short)(reinterpret_cast<unsigned>(&OF_handler) & 0xFFFF),
            .addr_high = (unsigned short)((reinterpret_cast<unsigned>(&OF_handler) >> 16) & 0xFFFF)
        }; //溢出
        idt_base[6] = IDT_item{
            .addr_low = (unsigned short)(reinterpret_cast<unsigned>(&UD_handler) & 0xFFFF),
            .addr_high = (unsigned short)((reinterpret_cast<unsigned>(&UD_handler) >> 16) & 0xFFFF)
        }; //无效指令
        idt_base[7] = IDT_item{
            .addr_low = (unsigned short)(reinterpret_cast<unsigned>(&NM_handler) & 0xFFFF),
            .addr_high = (unsigned short)((reinterpret_cast<unsigned>(&NM_handler) >> 16) & 0xFFFF)
        }; //设备不可用
        idt_base[8] = IDT_item{
            .addr_low = (unsigned short)(reinterpret_cast<unsigned>(&DF_handler) & 0xFFFF),
            .addr_high = (unsigned short)((reinterpret_cast<unsigned>(&DF_handler) >> 16) & 0xFFFF)
        }; //双重错误
        idt_base[13] = IDT_item{
            .addr_low = (unsigned short)(reinterpret_cast<unsigned>(&GP_handler) & 0xFFFF),
            .addr_high = (unsigned short)((reinterpret_cast<unsigned>(&GP_handler) >> 16) & 0xFFFF)
        }; //通用保护错误
        idt_base[32] = IDT_item{
            .addr_low = (unsigned short)(reinterpret_cast<unsigned>(&basic_time_handler) & 0xFFFF),
            .addr_high = (unsigned short)((reinterpret_cast<unsigned>(&basic_time_handler) >> 16) & 0xFFFF)
        }; //基本时钟中断

        struct {
            unsigned short _1;
            unsigned _2;
        }__attribute__((packed)) volatile idtr;
        idtr._1 = 255;
        idtr._2 = (unsigned )idt_base;
        asm volatile (
            "lidt %0"
            : 
            : "m"(idtr)
            : "memory"
        );
    };
};