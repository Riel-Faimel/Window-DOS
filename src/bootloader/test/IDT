void outb(char data, unsigned short port){
    asm volatile (
        "outb %0, %1"
        :
        : "a"(data), "Nd"(port)
        : "memory"
    );
}
inline void qps(const char *val){
    for(int i = 0;val[i];i++){
        outb(val[i], 0x3F8);
    }
}

