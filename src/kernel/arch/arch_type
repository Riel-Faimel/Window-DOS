#ifndef __kernel_src_arch_arch_type
#define __kernel_src_arch_arch_type

#include <global/type.hpp>

struct CPUInfo {
    enum class ArchType : u8 {
        x86, x86_64,
    } arch_type;
    u8 cpu_nums;
    u8 bit_num;
    u8 Segmentation_support : 1;
    u8 paging_support : 1;
    u8 Segmentation_mode : 1; // non-flat model
    u8 paging_mode : 1;
    u8 FPU_suppport : 1;
};

class CPUIndex {
    u16 id;
public:
    CPUIndex(): id{0} {}
    explicit CPUIndex(u16 id_): id{id_} {}
    explicit operator u16 () const { return id; }

    bool operator == (const CPUIndex &oth) const { return id == oth.id; }
};

#endif