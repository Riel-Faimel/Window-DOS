#ifndef __kernel_src_arch_arch_type
#define __kernel_src_arch_arch_type

#include <global/type.hpp>

struct CPUInfo {
    enum class ArchType : u8 {
        x86, x86_64,
    } arch_type;
    u8 cpu_nums;
    u8 bit_num;
    u8 Segmentation_support : 1;
    u8 paging_support : 1;
    u8 Segmentation_mode : 1; // non-flat model
    u8 paging_mode : 1;
    u8 FPU_suppport : 1;
};

#endif