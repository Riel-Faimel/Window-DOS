#ifndef __include_TL_condi_tranv
#define __include_TL_condi_tranv

#include <global/type.hpp>
#include <TL/concept>

namespace rtl {

template<typename T, typename R>
concept AccordCondition = requires (T t, const R &r) {
    rtl::is_same_t<decltype(t(r)), bool>;
};
    
template<typename Record, template <typename> typename Container>
class Filter {
    template<typename C>
    class Iterator;
    Container<Record> data;

    template<u32 N, typename... AC>
    class CondiView;
    class it;
public:
    template<AccordCondition<Record> AC>
    CondiView<0u, AC> filter(AC);
    it begin() const;
    it end() const;
};

// === iterator template ===

template<class Record, template<class> class Container> 
template<typename C> 
class Filter<Record, Container>::Iterator {
protected:
    using RIt = Container<Record>::Iterator;
    bool match(const Record &prog) const 
    { return static_cast<const C *>(this)->match(prog); }
private:
    RIt pif_this;
public:
    Iterator(const RIt &pit_): pif_this{pit_} {}
    bool operator != (const Iterator &oth) const 
    { return (pif_this != oth.pif_this); }
    Record &operator * () const { return *pif_this; }
    Iterator &operator ++ () { 
        match(*pif_this); // not yet
        return *this;
    }
};

// === conditions ===

template<class Record, template<typename> typename Container>
template<u32 N, typename AC, typename... Before> 
class Filter<Record, Container>::CondiView<N, AC, Before...> : CondiView<N-1, Before...> {
    AC ac;
    class it;
public:
    CondiView(CondiView<N-1, AC> oth, AC ac_):
    CondiView<N-1, Before...>{oth}, ac{ac_} {}

    template<AccordCondition<Record> Ac_>
    CondiView<N+1, Ac_> filter(Ac_ ac) { return {*this, ac}; }
    bool match(const Record &prog) const
    { return ac(prog) && CondiView<N-1, Before>::match(prog); }

    it begin() const;
    it end() const;
};

template<class Record, template<typename> typename Container>
template<AccordCondition<Record> AC> 
class Filter<Record, Container>::CondiView<0u, AC> {
    Container<Record> &space;
protected:
    auto get_begin() const { return space.begin(); }
    auto get_end() const { return space.end(); }
private:
    AC ac;
    class it;
public:
    CondiView(Container<Record> &s, AC ac_): space{s}, ac{ac_} {}

    CondiView<1u, AC> filter(AC ac) { return {*this, ac}; }
    bool match(const Record &pid) const { return ac(pid); }

    it begin() const;
    it end() const;
};

// === Iterators ===

template<class Record, template<class> class Container> 
class Filter<Record, Container>::it : public Filter<Record, Container>::Iterator<it> {
    friend class Filter<Record, Container>::Iterator<it>;
    bool match(const Record &) const { return true; }
public:
    it(const Iterator<it>::RIt &rit_): Iterator<it>{rit_} {}
};

template<class Record, template<typename> typename Container> 
template<u32 N, AccordCondition<Record> AC> 
class Filter<Record, Container>::CondiView<N, AC>::it : public Filter<Record, Container>::Iterator<it> {
    CondiView<N, AC> condition;
    friend class Filter<Record, Container>::Iterator<it>;
    bool match(const Record &pid) const { return condition.match(pid); }
public:
    it(const Iterator<it>::RIt &rit_, const CondiView<N, AC> &condition_):
    Iterator<it>{rit_}, condition{condition_} {}
};

template<class Record, template<typename> typename Container> 
template<AccordCondition<Record> AC> 
class Filter<Record, Container>::CondiView<0U, AC>::it : public Filter<Record, Container>::Iterator<it> {
    CondiView<0, AC> condition;
    friend class Filter<Record, Container>::Iterator<it>;
    bool match(const Record &pid) const { return condition.match(pid); }
public:
    it(const Iterator<it>::RIt &rit_, const CondiView<0, AC> &condition_):
    Iterator<it>{rit_}, condition{condition_} {}
};

template<typename Record, template <typename> typename Container>
Filter<Record, Container>::it Filter<Record, Container>::begin()
const 
{ return {data.begin()}; }
template<typename Record, template <typename> typename Container>
Filter<Record, Container>::it 
Filter<Record, Container>::end() 
const 
{ return {data.end()}; }
template<typename Record, template <typename> typename Container>
template<AccordCondition<Record> AC>
Filter<Record, Container>::CondiView<0U, AC> 
Filter<Record, Container>::filter(AC ac)
{ return {data, ac}; }

template<typename Record, template <typename> typename Container>
template<u32 N, AccordCondition<Record> AC> 
Filter<Record, Container>::CondiView<N, AC>::it 
Filter<Record, Container>::CondiView<N, AC>::begin() 
const 
{ return {CondiView<0u, AC>::space.begin(), *this}; }
template<typename Record, template <typename> typename Container>
template<u32 N, AccordCondition<Record> AC> 
Filter<Record, Container>::CondiView<N, AC>::it 
Filter<Record, Container>::CondiView<N, AC>::end() 
const 
{ return {CondiView<0u, AC>::space.end(), *this}; }

template<typename Record, template <typename> typename Container>
template<AccordCondition<Record> AC> 
Filter<Record, Container>::CondiView<0u, AC>::it 
Filter<Record, Container>::CondiView<0u, AC>::begin() 
const 
{ return {space.begin(), *this}; }
template<typename Record, template <typename> typename Container>
template<AccordCondition<Record> AC> 
Filter<Record, Container>::CondiView<0u, AC>::it 
Filter<Record, Container>::CondiView<0u, AC>::end() 
const 
{ return {space.end(), *this}; }

    
} // namespace rtl 

#include <TL/container>
