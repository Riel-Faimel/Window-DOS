#ifdef __independent_lib_Using_template_container
template<typename T>
class array {
    T *ptr;
    size_t size;
    size_t capacity;
public:
    array(size_t size_):size(0),capacity(size_){
        ptr = new T[capacity];
    }

    void append(const T &obj){
        if(size >= capacity){
            size_t new_capacity = capacity * 2;
            T *new_ptr = new T[new_capacity];
            for(size_t i = 0;i < size;i++){
                new_ptr[i] = ptr[i];
            }
            delete[] ptr;
            ptr = new_ptr;
            capacity = new_capacity;
        }
        ptr[size] = obj;
        size++;
    }

    T &operator[](size_t index){
        return ptr[index];
    }

    const T &operator[](size_t index) const {
        return ptr[index];
    }

    void remove(size_t index){
        if(index >= size)return;
        for(size_t i = index;i < size - 1;i++){
            ptr[i] = ptr[i + 1];
        }
        size--;
    }

    void insert(size_t index, const T &obj){
        if(index > size)return;
        if(size >= capacity){
            size_t new_capacity = capacity * 2;
            T *new_ptr = new T[new_capacity];
            for(size_t i = 0;i < size;i++){
                new_ptr[i] = ptr[i];
            }
            delete[] ptr;
            ptr = new_ptr;
            capacity = new_capacity;
        }
        for(size_t i = size;i > index;i--){
            ptr[i] = ptr[i - 1];
        }
        ptr[index] = obj;
        size++;
    }

    inline size_t get_size() const {
        return size;
    }

    T *get_ptr(){
        return ptr;
    }
};
