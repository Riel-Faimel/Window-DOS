#ifndef ___Using_utility
#define ___Using_utility

#include <TL/bits/utility>
#include <TL/bits/forward>

namespace rtl {

// delete & for T or T& or T&&
template<typename T>
struct remove_reference {
    using type = T;
};
template<typename T>
struct remove_reference<T&> {
    using type = T;
};
template<typename T>
struct remove_reference<T&&> {
    using type = T;
};

//catch and change to T&&
template<typename T>
constexpr decltype(auto) move(T &&obj){ //decltype for DO NOT automatic degradation
    return static_cast<typename remove_reference<T>::type &&>(obj);
}

template<typename T>
decltype(auto) forward(T &&t) {
    return bits::forward(t);
};

}

#endif
//#endif