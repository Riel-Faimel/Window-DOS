// the pointer, no address
template<typename T>
class vested_ptr {
    T *ptr;
    static T default_obj;
public:
    vested_ptr(T &obj_):ptr(&obj_){} // obj

    vested_ptr(vested_ptr &&vp_):
    ptr(vp_.ptr){
        vp_.ptr = nullptr;
    }

    vested_ptr &operator= (vested_ptr &&vp_){
        if(this != &vp_){
            ptr = vp_.ptr;
            vp_.ptr = nullptr;
        }
        return *this;
    } // move
    
    ~vested_ptr(){
        ptr = nullptr;
    }

    vested_ptr(vested_ptr &) = delete;
    vested_ptr operator= (vested_ptr &) = delete; // self & copy
    
    vested_ptr(const vested_ptr &) = delete;
    vested_ptr operator= (const vested_ptr &) = delete; // const self & copy

    vested_ptr(T *) = delete;
    vested_ptr operator= (T *) = delete; // ptr
    
    vested_ptr(const T *ptr_) = delete;
    vested_ptr operator= (const T *) = delete; // const ptr

    vested_ptr() = delete;

    T *get() const {
        return ptr;
    }

    explicit operator bool() const {
        if(ptr)return true;
        else return false;
    }

    T &operator *() {
        if(ptr)return *ptr;
        else return default_obj;
    }

    const T &operator *() const {
        if(ptr) return *ptr;
        else return default_obj;
    }

    void *operator new(size_t, dummy_ptr<T> *place){
        return place;
    }
};

template<typename T>
class aeonian_ptr {
    T *ptr;
public:
    aeonian_ptr(T &obj_):ptr(&obj_){}

    aeonian_ptr(aeonian_ptr &&) = delete;
    aeonian_ptr &operator= (aeonian_ptr &&) = delete; //self &&

    aeonian_ptr(aeonian_ptr &) = delete;
    aeonian_ptr &operator= (aeonian_ptr &) = delete; //self &

    aeonian_ptr(const aeonian_ptr &) = delete;
    aeonian_ptr &operator= (const aeonian_ptr &) = delete; //const self &

    aeonian_ptr(T *) = delete;
    aeonian_ptr operator= (T *) = delete; // pointer

    aeonian_ptr(const T *) = delete;
    aeonian_ptr operator= (const T *) = delete; // const pointer

    T &operator* (){
        return *ptr;
    }

    const T &operator* () const {
        return *ptr;
    }

    T *operator ->() noexcept {
        return ptr;
    }

    const T *operator->() const noexcept {
        return ptr;
    }

    void *operator new(size_t, dummy_ptr<T> *place){
        return place;
    }
};

template<typename T>
class dummy_ptr {
    T *space___all_right_so_anyway_this_object_will_not_be_used;
public:
    dummy_ptr() = default;

    T &operator *() = delete;

    T &operator ->() = delete;

    template<typename R, typename ...Args>
    R operator()(Args...);

    template<>
    vested_ptr<T> operator()<vested_ptr<T>, T &>(T &obj_) && = delete;
    template<>
    aeonian_ptr<T> operator()<aeonian_ptr<T>, T &>(T &obj_) && = delete;

    template<>
    vested_ptr<T> operator()<vested_ptr<T>, T &>(T &obj_) & {
        auto re = new (static_cast<void *>(this)) vested_ptr<T>(obj_);
        return move(*re);
    }

    template<>
    aeonian_ptr<T> operator()<aeonian_ptr<T>, T &>(T &obj_) & {
        auto re = new (static_cast<void *>(this)) aeonian_ptr<T>(obj_);
        return move(*re);
    }
};

class amorphous_ptr;

template<typename Return, typename ...Args>
class _callable {
    void *ptr;
    _callable(void *ptr_):ptr(ptr_){}
    friend class amorphous_ptr;
public:
    Return operator() (Args &&...args) const noexcept {
        using Functype = Return (*)(Args...);
        return reinterpret_cast<Functype>(ptr)(forward<Args>(args)...);
    }
};

class amorphous_ptr{
    void *ptr;
public:
    template<typename T>
    amorphous_ptr(T value){
        static_assert(sizeof(T) <= sizeof(void *), "T too big, can't use as address");
        static_assert(alignof(T) <= alignof(void *), "aliggnment doesn't match");

        ptr = reinterpret_cast<void *>(value);
    };

    template<typename Return, typename ...Args>
    operator _callable<Return, Args...>() const {
        return _callable<Return, Args...>(ptr);
    }
};

