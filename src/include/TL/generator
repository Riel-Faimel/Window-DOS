#ifndef __include_TL_generator
#define __include_TL_generator

namespace rtl{
    
template<typename Node>
struct list_tranveser {
    Node *first_node;
    Node *last_node = nullptr;
    struct Iterator {
        Node *thisptr;

        Node &operator*() const noexcept { return *thisptr; }
        bool operator!= (const Iterator &other) const noexcept 
        { return thisptr != other.thisptr; }
        Iterator &operator++ () { thisptr = thisptr->next_node();return *this; }
    };

    constexpr Iterator begin() { return {first_node}; }
    constexpr Iterator end() const { return {last_node}; }
};

} // namespace rtl

#endif