template<typename T, bool MultiFather = true, bool MultiSon = true>
class link {
    T data;
    using FatherPtr = typename conditional<MultiFather, multi_ptr<link<T, MultiFather, MultiSon>>, single_ptr<link<T, MultiFather, MultiSon>>>::type;
    using SonPtr = typename conditional<MultiSon, multi_ptr<link<T, MultiFather, MultiSon>>, single_ptr<link<T, MultiFather, MultiSon>>>::type;
    
    FatherPtr father;
    SonPtr son;
    
public:
    link(T data) : data{data} {}
    
    bool has_son(link* l) {
        for (auto* s : son) {
            if (s == l) return true;
        }
        return false;
    }
    
    void point_to(link* l) {
        if (has_son(l)) return;
        son.append(l);
        l->father.append(this);
    }
    
    void bind(link* l) {
        father.append(l);
        l->son.append(this);
    }
    
    auto get_father() const { return father; }
    auto get_son() const { return son; }
    T get_data() const { return data; }
    
    ~link() {
        for (auto* f : father) {
            for (auto* s : son) {
                f->point_to(s);
            }
        }
        
        for (auto* f : father) {
            f->son.remove(this);
        }
        for (auto* s : son) {
            s->father.remove(this);
        }
    }
};

