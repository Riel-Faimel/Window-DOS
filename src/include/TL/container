//dynamic array
template<typename T>
class array {
protected:
    T *ptr;
    size_t size;
    size_t capacity;

    class Iterator {
        T *ptr;
    public:
        Iterator(T* p):ptr{p}{}
        T &operator*(){
            return *ptr;
        }
        constexpr Iterator &operator++(){
            ptr++;
            return *this;
        }
        bool operator!=(const Iterator &other) const {
            return ptr != other.ptr;
        }
        bool operator!=(Iterator &other){
            return ptr != other.ptr;
        }
    };

    template<typename V>
    void __append(V &&obj){
        if(size >= capacity){
            size_t new_capacity = capacity * 2;
            T *new_ptr = new T [new_capacity];
            for(size_t i = 0;i < size;i++){
                new_ptr[i] = ptr[i];
            }
            delete[] ptr;
            ptr = new_ptr;
            capacity = new_capacity;
        }
        ptr[size] = bits::forward(obj);
        size++;
    }
    
public:
    array(size_t size_ = 1):size{0},capacity{size_}{
        ptr = new T[capacity];
    }

    ~array(){
        if(ptr) delete ptr;
    }

    constexpr void append(const T &obj) {
        __append(const_cast<T &>(obj));
    }
    constexpr void append(T &obj) {
        __append(bits::forward(obj));
    }
    constexpr void append(T &&obj) {
        __append(move(obj));
    }

    void init(T* ptr, size_t size_){
        if(!ptr)return;
        this->size = size_;
        capacity = 1;
        while(capacity < size_) capacity <<= 2;
        if (this->ptr) delete[] this->ptr;
        this->ptr = ptr;
    }

public:
    T &operator[](size_t index){ return ptr[index]; }
    void remove(size_t index){
        if(index >= size)return;
        for(size_t i = index;i < size - 1;i++){
            ptr[i] = ptr[i + 1];
        }
        size--;
    }
    void remove(const T &obj) {
        for(size_t i = 0; i < size; i++){
            if (ptr[i] == obj) {
                remove(i);
            }
        }
    }
    void insert(size_t index, const T &obj){
        if(index > size)return;
        if(size >= capacity){
            size_t new_capacity = capacity * 2;
            T *new_ptr = new T[new_capacity];
            for(size_t i = 0;i < size;i++){
                new_ptr[i] = ptr[i];
            }
            delete[] ptr;
            ptr = new_ptr;
            capacity = new_capacity;
        }
        for(size_t i = size;i > index;i--){
            ptr[i] = ptr[i - 1];
        }
        ptr[index] = obj;
        size++;
    } 
    size_t get_size() const { return size; } 
    T *get_ptr(){ return ptr; } 
    void clean(){ ptr = nullptr; } 
    constexpr Iterator begin(){ return Iterator{ptr}; } 
    constexpr Iterator end(){ return Iterator{ptr + size}; }
};

template<typename T>
struct list {
    struct Node {
        T data;
        Node* prev = nullptr;
        Node* next = nullptr;
        Node() {}
        Node(const T &val): data{val}{}
        Node(T &&val): data{move(val)}{}
    };
protected:
    Node* head = nullptr;
    Node* tail = nullptr;
    size_t size = 0;

    class Iterator {
        Node* ptr;
    public:
        Iterator(Node* p) : ptr{p} {}
        T& operator*() { return ptr->data; }
        auto operator->() { return &ptr->data; }
        Iterator& operator++() {
            ptr = ptr->next;
            return *this;
        }
        Iterator& operator--() {
            ptr = ptr->prev;
            return *this;
        }
        bool operator!=(Iterator& other) {
            return ptr != other.ptr;
        }
    };

    void tpend(Node *new_node) {
        if (!head) {
            head = tail = new_node;
        } else {
            tail->next = new_node;
            new_node->prev = tail;
            tail = new_node;
        }
        size++;
    }
    void ppend(Node *new_node) {
        if (!head) {
            head = tail = new_node;
        } else {
            new_node->next = head;
            head->prev = new_node;
            head = new_node;
        }
        size++;
    }

public:
    list(){}
    ~list() {
        while (head) {
            Node* temp = head;
            head = head->next;
            delete temp;
        }
    }

    void append(const T &obj) {
        Node *new_node = new Node{obj};
        tpend(new_node);
    }
    void prepend(const T &obj) {
        Node* new_node = new Node{obj};
        ppend(new_node);
    }
    void append(T &&obj) {
        Node* new_node = new Node{move(obj)};
        tpend(new_node);
    }
    void prepend(T &&obj) {
        Node* new_node = new Node{move(obj)};
        ppend(new_node);
    }

    T *space_append() {
        Node *new_node = new Node{};
        tpend(new_node);
        return &new_node->data;
    }
    T *space_prepend() {
        Node *new_node = new Node{};
        ppend(new_node);
        return &new_node->data;
    }

    T *pop_front() {
        if (!head) return nullptr;
        return &head->data;
    }
    T *pop_back() {
        if (!tail) return nullptr;
        return &tail->data;
    }

    void insert(size_t index, T obj) {
        if (index > size) return;
        if (index == 0) { prepend(obj); return; }
        if (index == size) { append(obj); return; }

        Node* current = head;
        for (size_t i = 0; i < index; i++) {
            current = current->next;
        }

        Node* new_node = new Node(obj);
        new_node->prev = current->prev;
        new_node->next = current;
        current->prev->next = new_node;
        current->prev = new_node;
        size++;
    }

    void remove(size_t index) {
        if (index >= size) return;

        Node* to_delete;
        if (index == 0) {
            to_delete = head;
            head = head->next;
            if (head) head->prev = nullptr;
            else tail = nullptr;
        } else if (index == size - 1) {
            to_delete = tail;
            tail = tail->prev;
            tail->next = nullptr;
        } else {
            Node* current = head;
            for (size_t i = 0; i < index; i++) {
                current = current->next;
            }
            to_delete = current;
            current->prev->next = current->next;
            current->next->prev = current->prev;
        }

        delete to_delete;
        size--;
    }
    void remove(T *data) {
        Node *need_to_delete = (Node *)(data);
        // first member of Node is data, so the address of data is the same as the address of Node
        for (Node *current = head; current; current = current->next) {
            if (current == need_to_delete) {
                if (current->prev) current->prev->next = current->next;
                else head = current->next;
                if (current->next) current->next->prev = current->prev;
                else tail = current->prev;
                delete current;
                size--;
                return;
            }
        }
    }
    void remove(const T &obj) {
        Node* current = head;
        while (current) {
            if (current->data == obj) {
                Node* to_delete = current;
                if (current->prev) current->prev->next = current->next;
                else head = current->next;
                if (current->next) current->next->prev = current->prev;
                else tail = current->prev;
                current = current->next;
                delete to_delete;
                size--;
            } else {
                current = current->next;
            }
        }
    }
    void remove(Node *node) {
        if (!node) return;
        if (node->prev) node->prev->next = node->next;
        else head = node->next;
        if (node->next) node->next->prev = node->prev;
        else tail = node->prev;
        delete node;
        size--;
    }
    void clear() {
        while (head) {
            Node* temp = head;
            head = head->next;
            delete temp;
        }
        tail = nullptr;
        size = 0;
    }
    T& operator[](size_t index) {
        Node* current = head;
        for (size_t i = 0; i < index; i++) {
            current = current->next;
        }
        return current->data;
    } 
    size_t get_size() { return size; } 
    bool empty() { return size == 0; }
    Iterator begin() { return Iterator{head}; } 
    Iterator end() { return Iterator{nullptr}; }

    list(list&& other): head(other.head), tail(other.tail), size(other.size) {
        other.head = nullptr;
        other.tail = nullptr;
        other.size = 0;
    }
    list& operator=(list&& other) {
        if (this == &other) return *this;
        clear();
        head = other.head;
        tail = other.tail;
        size = other.size;
        other.head = nullptr;
        other.tail = nullptr;
        other.size = 0;
        return *this;
    }

    list(list& other) = delete;
    list& operator=(list& other) = delete;
};

