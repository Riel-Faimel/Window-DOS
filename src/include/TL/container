//dynamic array
template<typename T>
class array {
protected:
    T *ptr;
    size_t size;
    size_t capacity;

    class Iterator {
        T *ptr;
    public:
        Iterator(T* p):ptr{p}{}
        T &operator*(){
            return *ptr;
        }
        constexpr Iterator &operator++(){
            ptr++;
            return *this;
        }
        bool operator!=(const Iterator &other) const {
            return ptr != other.ptr;
        }
        bool operator!=(Iterator &other){
            return ptr != other.ptr;
        }
    };
public:
    array(size_t size_ = 1):size{0},capacity{size_}{
        ptr = new T[capacity];
    }

    ~array(){
        if(ptr) delete ptr;
    }

    void append(const T &obj){
        if(size >= capacity){
            size_t new_capacity = capacity * 2;
            T *new_ptr = new T[new_capacity];
            for(size_t i = 0;i < size;i++){
                new_ptr[i] = ptr[i];
            }
            delete[] ptr;
            ptr = new_ptr;
            capacity = new_capacity;
        }
        ptr[size] = obj;
        size++;
    }

    inline T &operator[](size_t index){
        return ptr[index];
    }

    inline const T &operator[](size_t index) const {
        return ptr[index];
    }

    void remove(size_t index){
        if(index >= size)return;
        for(size_t i = index;i < size - 1;i++){
            ptr[i] = ptr[i + 1];
        }
        size--;
    }

    void remove(T obj) {
        for(size_t i = 0; i < size; i++){
            if (ptr[i] == obj) {
                remove(i);
            }
        }
    }

    void insert(size_t index, const T &obj){
        if(index > size)return;
        if(size >= capacity){
            size_t new_capacity = capacity * 2;
            T *new_ptr = new T[new_capacity];
            for(size_t i = 0;i < size;i++){
                new_ptr[i] = ptr[i];
            }
            delete[] ptr;
            ptr = new_ptr;
            capacity = new_capacity;
        }
        for(size_t i = size;i > index;i--){
            ptr[i] = ptr[i - 1];
        }
        ptr[index] = obj;
        size++;
    }

    inline size_t get_size() const {
        return size;
    }

    inline T *get_ptr(){
        return ptr;
    }

    inline void clean(){
        ptr = nullptr;
    }

    constexpr inline Iterator begin(){
        return Iterator{ptr};
    }

    constexpr inline Iterator end(){
        return Iterator{ptr + size};
    }
};

template<typename T, bool multi = true>
class node;

template<typename T>
class node<T, true> {
    T data;
    array<node<T, true>*> son{1};
public:
    node(T data_i) : data{data_i} {}

    void point(node<T, true> *n) {
        son.append(n);
    }

    inline node<T, true> *operator[](size_t i) {
        return son[i];
    }

    inline T get_data() const {
        return data;
    }

    virtual ~node() {
        for (auto *s : son) {
            delete s;
        }
    }
};

template<typename T>
class node<T, false> {
    T data;
    node<T, false> *next;
    
public:
    node(T data_i):data{data_i}{}
    
    node(T data_i, node &source_node):
    data{data_i}{
        source_node.point(this);
    }
    
    inline void point(node *n){
        next = n;
    };

    inline T get_data() const {
        return data;
    }

    inline operator node*(){
        return next;
    }

    ~node() {
        delete next;
    }
};

template<typename T>
class single_ptr {
    T* ptr{nullptr};
public:
    void append(T* p) { ptr = p; }
    void remove(T* p) { if (ptr == p) ptr = nullptr; }
    void clear() { ptr = nullptr; }
    size_t get_size() const { return ptr ? 1 : 0; }
    
    T*& operator[](size_t i) { return ptr; }
    T* operator[](size_t i) const { return ptr; }
    
    T** begin() { return &ptr; }
    T** end() { return ptr ? (&ptr + 1) : &ptr; }
};

template<typename T>
class multi_ptr {
    array<T*> arr{1};
public:
    void append(T* p) { arr.append(p); }
    void remove(T* p) { arr.remove(p); }
    void clear() { arr.clear(); }
    size_t get_size() const { return arr.get_size(); }
    
    T*& operator[](size_t i) { return arr[i]; }
    T* operator[](size_t i) const { return arr[i]; }
    
    auto begin() { return arr.begin(); }
    auto end() { return arr.end(); }
};

