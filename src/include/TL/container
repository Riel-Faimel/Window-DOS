template<typename N, typename M>
struct pair {
    N data_n;
    M data_m;
    pair(N n, M m):data_n{n}, data_m{m}{};
}; 

template<typename N, typename M>
class map {
    array<pair<N, M>> data;
public:
    map():data{1}{};
    map(size_t size):data{size}{};

    pair<N, M> &operator[](size_t i){
        return data[i];
    }
};

