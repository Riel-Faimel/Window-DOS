template<typename N, typename M>
struct pair {
    N key;
    M value;
    pair(N key_i, M value_i):key{key_i}, value{value_i}{};
}; 

template<typename N, typename M>
class map : public array<pair<N, M>>{
public:
    M &operator[](N key){
        for (unsigned i = 0; i < this->size; i++){
            if (this->ptr[i].key == key) return this->ptr[i].value;
        }
        append({key, {}});
        return this->ptr[this->size - 1].value;
    }
};

