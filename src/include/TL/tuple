#ifndef __include_TL_tuple
#define __include_TL_tuple

#include "bits/forward"

namespace rtl {
    
template<typename ...Type>
struct tuple;

template<typename Fir, typename... Args>
struct tuple<Fir, Args...> : public tuple<Args...> {
    Fir data;
    tuple(Fir f, Args... args):
    tuple<Args...>{args...}, data{f}{}

    tuple(tuple<Fir, Args...>& t):
    tuple<Args...>{static_cast<tuple<Args...>&>(t)}, data{t.data}{}

    tuple(tuple<Fir, Args...>&& t):
    tuple<Args...>{static_cast<tuple<Args...>&&>(t)}, data{t.data}{
        t.data = Fir{};
    }
};

template<>
struct tuple<> {
public:
    tuple() = default;
};

template<unsigned long long N, typename Fir, typename... Args>
auto& get(tuple<Fir, Args...>& t) {
    if constexpr (N==0) return t.data;
    else return get<N-1>(static_cast<tuple<Args...>&>(t));
}

template<unsigned long long N, typename Fir, typename... Args>
const auto& get(const tuple<Fir, Args...>& t) {
    if constexpr (N==0)return t.data;
    else return get<N-1>(static_cast<tuple<Args...>&>(t));
}

template<unsigned long long N, typename Fir, typename... Args>
auto&& get(tuple<Fir, Args...>&& t) {
    if constexpr (N==0)return bits::forward(t.data);
    else return get<N-1>(static_cast<tuple<Args...>&&>(t));
}

template<typename ...T>
constexpr tuple<T...> make_tuple(T...);

template<typename FirInit, typename ...OthInit>
constexpr tuple<FirInit, OthInit...> make_tuple(FirInit fir, OthInit... init) {
    tuple<FirInit, OthInit...>re{make_tuple(init...), fir};
    return re;
}
template<>
constexpr tuple<> make_tuple<>() {
    return tuple<>{}; 
}

};

namespace std{
    
template<typename... Args>
using tuple = rtl::tuple<Args...>;

template<typename... T>
struct tuple_size;

template<typename Fir, typename... Args>
struct tuple_size<tuple<Fir, Args...>> {
    constexpr static unsigned long long value = tuple_size<tuple<Args...>>::value + 1;
};

template<>
struct tuple_size<tuple<>> {
    constexpr static unsigned long long value = 0;
};

template<unsigned long long I, typename... T>
struct tuple_element;

template<unsigned long long I, typename Fir, typename... Args>
struct tuple_element<I, tuple<Fir, Args...>> {
    using type = typename tuple_element<I-1, tuple<Args...>>::type;
};

template<typename Fir, typename... Args>
struct tuple_element<0, tuple<Fir, Args...>> {
    using type = Fir;
};

template<unsigned long long I>
struct tuple_element<I, tuple<>> {
    using type = void;
};


} // namespace std

#endif