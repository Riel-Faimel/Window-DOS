#ifndef __include_TL_bits_utility
#define __include_TL_bits_utility

#include <TL/bits/forward>

namespace rtl
{

template<bool c, typename T1, typename T2>
struct conditional;

template<typename T1, typename T2>
struct conditional<true, T1, T2> {
    using type = T1;
};

template<typename T1, typename T2>
struct conditional<false, T1, T2> {
    using type = T2;
};

template<typename T>
struct decay {
    using type = int;
};

} // namespace rtl

#endif