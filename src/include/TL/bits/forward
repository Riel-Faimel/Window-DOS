#ifndef __bootloader_src_include_TL_bits_forward
#define __bootloader_src_include_TL_bits_forward

#include <TL/bits/utility>

namespace rtl {

namespace bits {

// append && back of T, because &&&->& and &&&&->&&, so it keep & nums
template<typename T>
constexpr remove_reference_t<T> & forward(T &t)noexcept{
    return t;
}
template<typename T>
constexpr remove_reference_t<T> && forward(T &&t)noexcept{
    return t;
}

};

};

#endif