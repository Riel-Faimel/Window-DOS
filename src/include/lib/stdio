#ifndef __include_lib_stdio
#define __include_lib_stdio

#include <global/type.hpp>

class OBackend {
public:
    virtual ~OBackend() = default;

    virtual void write(const char *buf, size_t len) = 0;
};

class ostream {
    OBackend *backend;

    void emit(const char *buf, size_t len) {
        if (backend && len) backend->write(buf, len);
    }

public:
    explicit ostream(OBackend *be = nullptr) : backend{be} {}

    // 换后端；返回原来的那个，方便临时切换后恢复（例如转储日志时
    // 先 change 到文件后端，dump 完再 change 回去）。
    OBackend *change(OBackend *be_) {
        OBackend *old = backend;
        backend = be_;
        return old;
    }

    ostream &operator<< (const char *s);
    ostream &operator<< (char c);
    ostream &operator<< (bool b);
    ostream &operator<< (unsigned char i);
    ostream &operator<< (unsigned short i);
    ostream &operator<< (unsigned i);
    ostream &operator<< (int i);
    ostream &operator<< (unsigned long long i);
    ostream &operator<< (u64 i);
    ostream &operator<< (void *p);

    void ch(char c);
    void str(const char *s, char end);
    void hex(unsigned char i);
    void hex(unsigned short i);
    void hex(unsigned i);
    void hex(int i);
};

extern ostream kout;


#endif
