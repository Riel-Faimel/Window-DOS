#ifndef __lib_cppstdlib_string
#define __lib_cppstdlib_string

#include <HL/container>

class String{
    char *data;
    unsigned len;

    class iterator {
        char *ptr;

    public:
        iterator(char *ptr_): ptr{ptr_}{}
        ~iterator() = default;

        constexpr bool operator!= (const iterator &it) const {
            return ptr != it.ptr;
        }
        constexpr iterator &operator++() {
            ptr+=1;
            return *this;
        }
        constexpr iterator operator++(int ) = delete;
        constexpr char operator* () const { return *ptr; }
    };
public:
    constexpr String() noexcept: data(nullptr), len(0) {}

    // constexpr 隐含 inline，定义必须对每个使用它的 TU 可见，所以放在头里。
    // 有 new 没关系：只要不在常量求值里调用，它就是普通运行期分配。
    constexpr String(const char *s) noexcept {
        if (s == nullptr) {
            data = nullptr;
            len = 0;
            return;
        }

        len = 0;
        while (s[len]) len++;

        data = new char[len + 1];
        for (unsigned i = 0; i < len; i++) data[i] = s[i];
        data[len] = '\0';
    }
    String(char *s, unsigned n) noexcept;
    String(const String &s) noexcept;
    String(String &&s) noexcept;
    String(unsigned n) noexcept;
    String(unsigned n, char c) noexcept;
    ~String();

    String& operator=(const String &s) noexcept;
    String& operator=(String &&s) noexcept;

    unsigned length() const;
    bool empty() const;
    char * c_str() const;

    bool operator==(const String &s) const;
    bool operator==(const char *s) const;
    bool operator!=(const String &s) const;

    String operator+(const String &s) const;
    String operator+(char ) const;
    String& operator+=(const String &s);
    String& operator+=(const char *s);
    String& operator+=(char );

    void clear();
    void append(char c);
    void append(const char *s);
    void append(const String &s);

    int to_int() const;
    String substr(int pos) const;
    String substr(int pos, int len) const;

    unsigned find(const String &s) const;
    unsigned find(const char *s) const;

    rtl::array<String> split(const String &delimiter) const;
    rtl::array<String> split(const char *delimiter) const;
    rtl::array<String> split(char ) const;

    String trim() const;
    String trim_left() const;
    String trim_right() const;

    String extract_param(const char *) const;
    unsigned extract_int(const char *) const;

    String get_word(char);

    operator const char *() const;
    iterator begin() const { return iterator{data}; }
    iterator end() const { return iterator{data+len}; }
};

inline String::String(String &&s) noexcept :data(s.data), len(s.len){
    s.data = nullptr;
    s.len = 0;
}
inline bool String::operator!=(const String &s) const {
    return !(*this == s);
}
inline String::operator const char *() const {
    return c_str();
}
inline unsigned String::length() const {
    return len;
}
inline char * String::c_str() const {
    return data ? data : const_cast<char *>("");
}
inline bool String::empty() const {
    return len == 0;
}

#endif