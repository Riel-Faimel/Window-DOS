#ifndef __include_lib_cppstdlib_atomic
#define __include_lib_cppstdlib_atomic

namespace {
#ifdef _BITS_32
class atomic_chg {
    unsigned long long val;
public:
    atomic_chg(unsigned long long v = 0): val{v}{}
    unsigned long long cmpxchg(unsigned long long cmp, unsigned long long nval) {
        unsigned long long re;
        asm volatile (
            "lock cmpxchg8b %1"
            : "=A"(re), "+m"(val)
            : "b"((unsigned int)nval), "c"((unsigned int)(nval >> 32)),
              "A"(cmp)
            : "memory"
        );
        return re;
    }
};
#endif
#ifdef _BITS_64
class atomic_chg {
    unsigned long long val;
public:
     atomic_chg(unsigned long long v = 0): val{v}{}
     unsigned long long cmpxchg(unsigned long long cmp, unsigned long long nval) {
        unsigned long long re = cmp;
        asm volatile (
            "lock cmpxchgq %2, %1"
            : "=a"(re), "+m"(val)
            : "r"(nval), "0"(cmp)
            : "memory"
        );
        return re;
    }
};
#endif
}

template<typename T>
class atomic;

template<typename T>
class atomic_base {
protected:
    atomic_chg locking;
    
    static unsigned long long to_ull(T v) {
        unsigned long long result = 0;
        union { T t; unsigned long long u; } converter;
        converter.t = v;
        return converter.u;
    }
    
    static T from_ull(unsigned long long v) {
        union { unsigned long long u; T t; } converter;
        converter.u = v;
        return converter.t;
    }
    
public:
    atomic_base(T v = T{}) : locking(to_ull(v)) {}
    
    T load() {
        return from_ull(locking.cmpxchg(0, 0));
    }
    
    bool try_store(T v) {
        unsigned long long old = locking.cmpxchg(0, 0);
        unsigned long long expected = old;
        unsigned long long desired = to_ull(v);
        return locking.cmpxchg(expected, desired) == expected;
    }
    
    bool try_exchange(T v, T* old_value) {
        unsigned long long old = locking.cmpxchg(0, 0);
        unsigned long long expected = old;
        unsigned long long desired = to_ull(v);
        unsigned long long result = locking.cmpxchg(expected, desired);
        if (result == expected) {
            *old_value = from_ull(old);
            return true;
        }
        return false;
    }
    
     bool try_compare_exchange(T& expected, T desired) {
        unsigned long long exp = to_ull(expected);
        unsigned long long des = to_ull(desired);
        unsigned long long old = locking.cmpxchg(exp, des);
        if (old == exp) {
            return true;
        }
        expected = from_ull(old);
        return false;
    }
};

template<>
class atomic<bool> : public atomic_base<bool> {
    using atomic_base<bool>::atomic_base;
    
public:
     atomic(bool v = false) : atomic_base<bool>(v) {}
    
     bool try_lock() {
        return locking.cmpxchg(0, 1) == 0;
    }
    
     bool unlock() {
        return locking.cmpxchg(1, 0) == 1;
    }
};

template<>
class atomic<unsigned char> : public atomic_base<unsigned char> {
    using atomic_base<unsigned char>::atomic_base;
    
public:
     atomic(unsigned char ch = 0) : atomic_base<unsigned char>(ch) {}
    
     bool try_chg(unsigned char new_val, unsigned char* old_val) {
        return try_exchange(new_val, old_val);
    }
};

template<>
class atomic<unsigned long long> : public atomic_base<unsigned long long> {
    using atomic_base<unsigned long long>::atomic_base;
    
public:
    atomic(unsigned long long v = 0) : atomic_base<unsigned long long>(v) {}
    
    bool try_add(unsigned long long arg, unsigned long long* old) {
        unsigned long long current = locking.cmpxchg(0, 0);
        unsigned long long expected = current;
        unsigned long long desired = current + arg;
        unsigned long long result = locking.cmpxchg(expected, desired);
        if (result == expected && old) {
            *old = current;
            return true;
        }
        return false;
    }
    
    bool try_sub(unsigned long long arg, unsigned long long* old) {
        return try_add(-arg, old);
    }
    
    bool try_and(unsigned long long arg, unsigned long long* old) {
        unsigned long long current = locking.cmpxchg(0, 0);
        unsigned long long expected = current;
        unsigned long long desired = current & arg;
        unsigned long long result = locking.cmpxchg(expected, desired);
        if (result == expected && old) {
            *old = current;
            return true;
        }
        return false;
    }
    
    bool try_or(unsigned long long arg, unsigned long long* old) {
        unsigned long long current = locking.cmpxchg(0, 0);
        unsigned long long expected = current;
        unsigned long long desired = current | arg;
        unsigned long long result = locking.cmpxchg(expected, desired);
        if (result == expected && old) {
            *old = current;
            return true;
        }
        return false;
    }
    
    bool try_xor(unsigned long long arg, unsigned long long* old) {
        unsigned long long current = locking.cmpxchg(0, 0);
        unsigned long long expected = current;
        unsigned long long desired = current ^ arg;
        unsigned long long result = locking.cmpxchg(expected, desired);
        if (result == expected && old) {
            *old = current;
            return true;
        }
        return false;
    }
};

template<typename T>
class atomic {
    T data;
    atomic_chg lock;
    
public:
     atomic(T v = T{}) : data(v), lock(0) {}
    
     bool try_lock() {
        return lock.cmpxchg(0, 1) == 0;
    }
    
     bool try_unlock() {
        return lock.cmpxchg(1, 0) == 1;
    }
    
     bool try_load(T& result) {
        if (!try_lock()) return false;
        result = data;
        try_unlock();
        return true;
    }
    
     bool try_store(T v) {
        if (!try_lock()) return false;
        data = v;
        try_unlock();
        return true;
    }
    
     bool try_exchange(T v, T& old) {
        if (!try_lock()) return false;
        old = data;
        data = v;
        try_unlock();
        return true;
    }
    
     bool try_compare_exchange(T& expected, T desired) {
        if (!try_lock()) return false;
        if (data == expected) {
            data = desired;
            try_unlock();
            return true;
        }
        expected = data;
        try_unlock();
        return false;
    }
};

#endif